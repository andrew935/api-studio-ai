# Application database. Replace these example credentials locally.
DATABASE_URL=postgresql+asyncpg://app:change-me-local-only@localhost:5433/api_studio_ai
POSTGRES_PASSWORD=change-me-local-only

# Public origin used to build upload links. Do not add a trailing slash.
PUBLIC_BASE_URL=http://localhost:8000
API_HOST_PORT=8000
LOG_LEVEL=INFO

# Authentication. Generate a long random secret for every environment.
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ISSUER=api-studio-ai
JWT_AUDIENCE=api-studio-ai-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_HMAC_KEY=replace-with-a-different-long-random-secret
LOGIN_IP_LIMIT=100
LOGIN_IP_WINDOW_SECONDS=900
LOGIN_EMAIL_LIMIT=10
LOGIN_EMAIL_WINDOW_SECONDS=900
LOGIN_PAIR_LIMIT=5
LOGIN_PAIR_WINDOW_SECONDS=300
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_AUTH_ISSUER_URL=http://localhost:8000
MCP_BIND_HOST=127.0.0.1
MCP_BIND_PORT=8001
UPLOAD_SESSION_AUDIENCE=api-studio-ai-upload
UPLOAD_SESSION_EXPIRE_MINUTES=30
UPLOAD_COOKIE_SECURE=true

# File storage. Use "local" for development and "s3" in production.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage/uploads
MAX_UPLOAD_SIZE_MB=15
S3_REGION=us-east-1
S3_CIRCUIT_FAILURE_THRESHOLD=3
S3_CIRCUIT_RECOVERY_SECONDS=30
# S3_BUCKET=your-private-document-bucket
# S3_ENDPOINT_URL=https://s3-compatible-endpoint.example.com
# Boto3 loads credentials from its standard provider chain or an IAM role.
